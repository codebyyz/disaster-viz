# 复制本文件为 .env 并填入自己的值。
# .env 已被 .gitignore 忽略，不会提交到 GitHub（key 属于敏感信息）。

# NASA FIRMS Map Key（免费注册，发到邮箱）
# 注册地址：https://firms.modaps.eosdis.nasa.gov/api/map_key
# 留空时，/fires 接口会返回 400 并提示缺 key。
FIRMS_MAP_KEY=

# 演示模式：设为 1 时 /fires 返回样例数据（不调 NASA，不需要 key）。
# 页面顶部会显示「演示数据」徽标。正式使用请保持为空或 0。
FIRMS_DEMO=
